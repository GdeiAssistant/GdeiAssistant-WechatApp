/* GdeiAssistant brand tokens, shared with Web / Android / iOS. Light (default) and Dark. */

page {
  --color-primary: #0E8F6E;
  --color-primary-hover: #0A7559;
  --color-primary-soft: #E3F3EE;
  --color-on-primary: #FFFFFF;

  --color-bg-primary: #F4F7F6;
  --color-bg-secondary: #EAF0EE;
  --color-bg-tertiary: #E1E9E6;
  --color-surface: #FFFFFF;
  --color-surface-raised: #FFFFFF;

  --color-text-primary: #11201C;
  --color-text-secondary: #4E5F5A;
  --color-text-tertiary: #6F7F7A;
  --color-border: #DDE6E3;
  --color-divider: #E9EFED;

  --color-danger: #D14343;
  --color-danger-soft: #FBEAEA;
  --color-warning: #B7791F;
  --color-warning-soft: #F8EEDC;
  --color-link: #0E8F6E;
  --color-overlay: rgba(17, 32, 28, 0.5);

  --radius-card: 28rpx;
  --radius-control: 20rpx;
  --radius-full: 999rpx;
  --shadow-card: 0 4rpx 20rpx rgba(17, 32, 28, 0.05);
  --shadow-raised: 0 12rpx 40rpx rgba(17, 32, 28, 0.12);
}

.theme-dark {
  --color-primary: #34C79A;
  --color-primary-hover: #5AD6AE;
  --color-primary-soft: #12332A;
  --color-on-primary: #0E1513;

  --color-bg-primary: #0E1513;
  --color-bg-secondary: #1C2724;
  --color-bg-tertiary: #222D2A;
  --color-surface: #151E1B;
  --color-surface-raised: #1C2724;

  --color-text-primary: #E6EEEB;
  --color-text-secondary: #A3B3AE;
  --color-text-tertiary: #84948F;
  --color-border: #2A3733;
  --color-divider: #222D2A;

  --color-danger: #F07171;
  --color-danger-soft: #3A1E1E;
  --color-warning: #E0A54A;
  --color-warning-soft: #352915;
  --color-link: #34C79A;
  --color-overlay: rgba(0, 0, 0, 0.6);

  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.24);
  --shadow-raised: 0 12rpx 40rpx rgba(0, 0, 0, 0.4);

  min-height: 100vh;
  background-color: var(--color-bg-primary);
  color: var(--color-text-primary);
}
