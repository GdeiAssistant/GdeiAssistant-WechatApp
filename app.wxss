@import './styles/theme.wxss';

/*
 * Global layer: base typography, native component skin and a few shared layout helpers.
 * Grouped surfaces are flat (no outline, no drop shadow); hierarchy comes from spacing and type.
 */

page {
  background-color: var(--color-bg-primary);
  color: var(--color-text-primary);
  height: 100%;
  font-size: 30rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-variant-numeric: tabular-nums;
  padding-bottom: env(safe-area-inset-bottom);
  -webkit-font-smoothing: antialiased;
}

checkbox,
radio {
  margin-right: 12rpx;
}

form {
  width: 100%;
}

/* Buttons: one filled primary, one quiet secondary, one destructive. Radius 20rpx (10px). */
button {
  min-height: 96rpx;
  border-radius: var(--radius-control);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
  background-color: var(--color-surface);
  color: var(--color-text-primary);
}

button::after {
  border-color: var(--color-border);
  border-radius: calc(var(--radius-control) * 2);
}

button[type="primary"] {
  background-color: var(--color-fill-primary);
  color: var(--color-on-primary);
}

button[type="primary"]::after,
button[type="warn"]::after {
  border-color: transparent;
}

.button-hover {
  background-color: var(--color-bg-secondary);
}

.button-hover[type="primary"] {
  background-color: var(--color-primary-pressed);
  color: var(--color-on-primary);
}

button[type="primary"][disabled] {
  background-color: var(--color-fill-primary);
  color: var(--color-on-primary);
  opacity: 0.45;
}

button[type="default"][disabled] {
  background-color: var(--color-surface);
  color: var(--color-text-tertiary);
}

button[type="warn"] {
  background-color: var(--color-danger-soft);
  color: var(--color-danger-ink);
}

button[type="warn"][disabled] {
  background-color: var(--color-danger-soft);
  color: var(--color-danger-ink);
  opacity: 0.5;
}

button[size="mini"] {
  min-height: 64rpx;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
}

button[size="mini"]::after {
  border-radius: var(--radius-full);
}

button[plain] {
  background-color: transparent;
}

input,
textarea {
  color: var(--color-text-primary);
  caret-color: var(--color-primary);
}

.input-placeholder,
.textarea-placeholder {
  color: var(--color-text-tertiary);
}

.strong {
  font-weight: 700;
}

.tc {
  text-align: center;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  justify-content: space-between;
  font-size: 30rpx;
}

.page-body {
  width: 100%;
  flex-grow: 1;
  overflow-x: hidden;
}

.page-section {
  width: 100%;
  margin-bottom: 24rpx;
}

.page-section:last-child {
  margin-bottom: 0;
}

.page-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  padding-left: var(--gutter);
  padding-right: var(--gutter);
}

.btn-area {
  margin-top: 48rpx;
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--gutter);
}

.btn-area button {
  margin-top: 20rpx;
  margin-bottom: 0;
}

.btn-area button:first-child {
  margin-top: 0;
}

/*
 * Press feedback shared by navigator/cell/card hovers: 0.12s ease with a
 * subtle 0.98 scale, plus a tint shift for full-width rows where scaling
 * would show page background at the edges.
 */
.weui-cell,
.weui-grid,
.shortcut_card,
.interaction_card,
.weui-form-preview__btn {
  transition: transform var(--duration-press) ease, background-color var(--duration-press) ease, opacity var(--duration-press) ease;
}

.weui-grid_active,
.shortcut_card_active,
.interaction_card_active,
.weui-form-preview__btn_active {
  transform: scale(var(--scale-press));
}

navigator[hover-class="none"] {
  transition: none;
}
