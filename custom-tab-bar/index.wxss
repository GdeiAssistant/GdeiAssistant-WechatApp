@import '../styles/theme.wxss';

/*
 * Custom tab bar (首页 / 消息 / 我的). Single brand accent for the selected
 * state, 1dp top hairline instead of shadow, icons drawn in currentColor.
 */
.tabbar {
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--color-surface);
  border-top: 1rpx solid var(--color-divider);
}

/* theme.wxss sets a full-viewport .theme-dark root; the bar only needs vars. */
.tabbar.theme-dark {
  min-height: 0;
  background-color: var(--color-surface);
  color: var(--color-text-primary);
}

.tabbar_item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 16rpx;
  color: var(--color-text-tertiary);
  transition: transform var(--duration-press) ease, opacity var(--duration-press) ease;
}

.tabbar_item_hover {
  transform: scale(var(--scale-press));
  opacity: 0.8;
}

.tabbar_item.is_selected {
  color: var(--color-primary);
}

.tabbar_icon {
  position: relative;
  width: 40rpx;
  height: 36rpx;
}

.tabbar_label {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

/* Home: house outline */
.tabbar_icon_home {
  box-sizing: border-box;
  margin-top: 14rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
}

.tabbar_icon_home::before {
  content: '';
  position: absolute;
  top: 0;
  left: 6rpx;
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  border-top-left-radius: 4rpx;
  transform: rotate(45deg);
}

/* Messages: chat bubble with a tail */
.tabbar_icon_messages {
  box-sizing: border-box;
  margin-top: 6rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-radius: 12rpx;
}

.tabbar_icon_messages::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 7rpx;
  width: 12rpx;
  height: 12rpx;
  background-color: currentColor;
  clip-path: polygon(0 0, 100% 0, 0 100%);
}

/* Profile: head + shoulders */
.tabbar_icon_profile::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.tabbar_icon_profile::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 3rpx;
  width: 34rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 34rpx 34rpx 0 0;
  box-sizing: border-box;
}
