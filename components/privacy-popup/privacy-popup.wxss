.privacy_mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  background-color: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy_dialog {
  width: 100%;
  max-width: 600rpx;
  background-color: var(--color-surface, #ffffff);
  color: var(--color-text-primary, #1f2937);
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.privacy_title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy_desc {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text-secondary, #4b5563);
  margin-bottom: 36rpx;
}

.privacy_link {
  color: var(--color-primary, #0e7c61);
  margin-left: 8rpx;
  text-decoration: underline;
}

.privacy_actions {
  display: flex;
  gap: 20rpx;
}

.privacy_btn {
  flex: 1;
  min-height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  margin: 0;
}
