@import "../../common/lib/weui.wxss";

.page {
  min-height: 100vh;
  background: var(--color-bg-primary);
  padding-bottom: 48rpx;
}

.card {
  margin: 24rpx;
  padding: 30rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.header {
  display: flex;
  align-items: flex-start;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: var(--color-bg-secondary);
}

.name {
  font-size: 34rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.intro {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.relation {
  margin-top: 10rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  gap: 16rpx;
}

.stat {
  flex: 1 1 0;
  min-width: 0;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx 8rpx;
}

.stat_value {
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--color-text-primary);
}

.stat_label {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--color-text-tertiary);
  white-space: normal;
  word-break: break-word;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.actions button {
  margin: 0;
}

.loading_box,
.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-tertiary);
}
