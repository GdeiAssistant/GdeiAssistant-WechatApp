@import "../../common/lib/weui.wxss";

.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-bg-primary);
}

/* Public profile uses the same brand band as "my profile"; actions sit below it on the canvas. */
.card {
  padding: 40rpx var(--gutter) 32rpx;
  background: var(--color-band);
  border-radius: 0 0 var(--radius-card) var(--radius-card);
}

.header {
  display: flex;
  align-items: flex-start;
}

.header > view {
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  margin-right: 28rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-band-chip);
  background: var(--color-band-chip);
  flex-shrink: 0;
}

.name {
  color: var(--color-on-band);
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1.2;
  word-break: break-word;
}

.intro {
  margin-top: 12rpx;
  color: var(--color-on-band);
  font-size: var(--font-meta);
  line-height: 1.6;
  word-break: break-word;
}

.relation {
  margin-top: 12rpx;
  color: var(--color-on-band-muted);
  font-size: var(--font-meta);
  line-height: 1.5;
}

.stats {
  display: flex;
  margin-top: 32rpx;
  border-radius: var(--radius-control);
  background: var(--color-band-chip);
}

.stat {
  flex: 1 1 0;
  min-width: 0;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  text-align: center;
}

.stat + .stat {
  border-left: 1rpx solid var(--color-band-chip);
}

.stat_value {
  color: var(--color-on-band);
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.stat_label {
  margin-top: 4rpx;
  color: var(--color-on-band-muted);
  font-size: var(--font-caption);
  line-height: 1.35;
  white-space: normal;
  word-break: break-word;
}

/* Follow is the one filled action; message and block are quieter siblings. */
.actions {
  display: flex;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
  margin: 0;
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 12rpx;
  background: var(--color-band-chip);
  color: var(--color-on-band);
}

.actions button + button {
  margin-left: 16rpx;
}

.actions button[type="primary"] {
  background: var(--color-surface);
  color: var(--color-primary-ink);
}

.actions button[type="warn"] {
  background: var(--color-band-chip);
  color: var(--color-on-band);
}

.actions button::after {
  border-color: transparent;
}

.loading_box,
.empty {
  margin: 32rpx var(--gutter) 0;
  padding: 48rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.6;
}

.loading_box text {
  display: block;
  margin-top: 12rpx;
}
