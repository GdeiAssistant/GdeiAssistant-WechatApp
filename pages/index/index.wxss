@import "../../common/lib/weui.wxss";

.container {
  background: var(--c-bg);
  justify-content: flex-start;
}

/* Brand band: the one loud element of the app. Solid emerald, no gradient. */
.home_band {
  background: var(--c-primary);
  padding: 24rpx var(--gutter) 48rpx;
  border-radius: 0 0 var(--radius-card) var(--radius-card);
}

.theme-dark .home_band {
  background: var(--c-primary-soft);
}

.theme-dark .userinfo_notice_badge {
  border-color: var(--c-primary-soft);
}

.userinfo_card {
  display: flex;
  flex-direction: column;
}

.home_band_top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home_brand {
  color: var(--color-on-band);
  font-size: var(--ds-font-headline);
  font-weight: 700;
}

.userinfo_notice {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-full);
  background: var(--color-band-chip);
}

.userinfo_notice_icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.92;
}

.userinfo_notice_badge {
  position: absolute;
  top: 4rpx;
  right: 0;
  min-width: 32rpx;
  padding: 2rpx 10rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  border: 3rpx solid var(--c-primary);
  background: var(--c-danger);
  color: var(--color-on-band);
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.userinfo {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  min-width: 0;
}

.userinfo-avatar {
  width: 120rpx;
  height: 120rpx;
  margin-right: 28rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-band-chip);
  background: var(--color-band-chip);
  flex-shrink: 0;
}

.userinfo_meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.userinfo-nickname {
  color: var(--color-on-band);
  font-size: var(--ds-font-headline);
  font-weight: 700;
  line-height: 1.2;
  word-break: break-word;
}

.userinfo-entry {
  align-self: flex-start;
  margin-top: 32rpx;
  padding: 0 32rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--color-band-chip);
  color: var(--color-on-band);
  font-size: var(--ds-font-callout);
  font-weight: 600;
}

/* Service sections sit on the canvas below the band. */
.page-body {
  padding: 0 var(--space-page);
}

.page__bd {
  padding-bottom: 0;
  background: transparent;
}

.section_title {
  margin: 24rpx 0 0;
  padding: 24rpx 32rpx 16rpx;
  background: var(--c-surface);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  color: var(--c-text-1);
  font-size: var(--ds-font-headline);
  font-weight: 700;
  line-height: 1.4;
}

.weui-grids + .section_title {
  margin-top: 40rpx;
}

.weui-grid__label {
  color: var(--c-text-1);
  font-size: var(--ds-font-callout);
}

.weui-grids {
  margin: 0;
  background: var(--c-surface);
  border-radius: 0 0 var(--radius-card) var(--radius-card);
}

.weui-grid__icon {
  padding: 16rpx;
  border-radius: 20rpx;
  background: var(--c-primary-soft);
}

.userinfo-date {
  margin-top: 12rpx;
  color: var(--color-on-band-muted);
  font-size: var(--ds-font-callout);
}

.today-card {
  position: relative;
  margin-top: -24rpx;
  padding: 32rpx;
  border-radius: var(--radius-card);
  background: var(--c-surface);
  color: var(--c-text-1);
}

.today-card__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: var(--ds-font-headline);
  font-weight: 700;
}

.today-card__source,
.today-card__footer,
.today-card__location {
  color: var(--c-text-2);
  font-size: var(--ds-font-caption);
  font-weight: 400;
}

.today-card__lesson {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 24rpx;
}

.today-card__period {
  max-width: 200rpx;
  color: var(--c-primary);
  font-size: var(--ds-font-callout);
  flex-shrink: 0;
}

.today-card__detail {
  display: flex;
  flex-direction: column;
  min-width: 0;
  word-break: break-word;
}

.today-card__name {
  font-size: var(--ds-font-body);
  font-weight: 600;
}

.today-card__status {
  display: block;
  margin-top: 24rpx;
  font-size: var(--ds-font-body);
}

.today-card__footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.copyright_info {
  margin: 56rpx var(--gutter) 48rpx;
  color: var(--c-text-2);
  font-size: var(--ds-font-caption);
  line-height: 1.6;
  text-align: center;
}
