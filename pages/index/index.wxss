@import "../../common/lib/weui.wxss";

.container {
  background: var(--color-bg-primary);
}

.userinfo_card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.userinfo {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.page-body {
  margin-top: 8rpx;
}

.userinfo-avatar {
  width: 112rpx;
  height: 112rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: var(--color-bg-secondary);
  flex-shrink: 0;
}

.userinfo_meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.userinfo-nickname {
  color: var(--color-text-primary);
  font-size: 34rpx;
  font-weight: 600;
  word-break: break-word;
}

.userinfo-source {
  margin-top: 8rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-word;
}

.userinfo-entry {
  margin-top: 12rpx;
  padding: 8rpx 0;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.userinfo_notice {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: 24rpx;
  border-radius: var(--radius-control);
  background: var(--color-primary-soft);
  flex-shrink: 0;
}

.userinfo_notice_icon {
  width: 42rpx;
  height: 42rpx;
}

.userinfo_notice_badge {
  position: absolute;
  top: -10rpx;
  right: -12rpx;
  min-width: 36rpx;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-full);
  background: var(--color-danger);
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.section_title {
  margin: 36rpx 0 8rpx;
  padding: 0 40rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
}

.weui-grids {
  margin: 0 16rpx 8rpx;
  padding: 0;
  overflow: visible;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.weui-grids:before {
  display: none;
}

.weui-grids:after {
  content: " ";
  display: table;
  clear: both;
}

.weui-grid {
  float: left;
  width: 31.4%;
  margin: 0 0.96% 16rpx;
  padding: 28rpx 8rpx 22rpx;
  box-sizing: border-box;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.weui-grid:before,
.weui-grid:after {
  display: none;
}

.weui-grid_active {
  background: var(--color-primary-soft);
}

.weui-grid__icon {
  width: 48rpx;
  height: 48rpx;
  padding: 18rpx;
  border-radius: var(--radius-control);
  background: var(--color-primary-soft);
}

.weui-grid__label {
  margin-top: 14rpx;
  color: var(--color-text-primary);
  font-size: 24rpx;
}

.copyright_info {
  margin: 24rpx 0 40rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  line-height: 1.6;
}
