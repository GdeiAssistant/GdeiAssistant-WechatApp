@import "../../common/lib/weui.wxss";

.container {
  background: var(--color-bg-primary);
  justify-content: flex-start;
}

/* Brand band: the one loud element of the app. Solid emerald, no gradient. */
.home_band {
  display: flex;
  align-items: center;
  background: var(--color-band);
  padding: 28rpx var(--gutter) 40rpx;
  border-radius: 0 0 var(--radius-card) var(--radius-card);
}

.home_logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.home_band_meta {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  min-width: 0;
}

.home_greeting {
  color: var(--color-on-band);
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.3;
}

.home_date {
  margin-top: 4rpx;
  color: var(--color-on-band-muted);
  font-size: var(--font-caption);
  line-height: 1.4;
}

/* Service sections sit on the canvas below the band. */
.page-body {
  padding-top: 8rpx;
}

.page__bd {
  padding-bottom: 0;
  background: transparent;
}

.section_title {
  margin: 48rpx 0 0;
  padding: 0 calc(var(--gutter) + 8rpx) 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  font-weight: 600;
  line-height: 1.4;
}

.weui-grids + .section_title {
  margin-top: 40rpx;
}

.weui-grid__label {
  color: var(--color-text-primary);
}

.copyright_info {
  margin: 56rpx var(--gutter) 48rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
  line-height: 1.6;
  text-align: center;
}
