<view class="container {{themeClass}}" style="{{fontStyle}}">

<official-account></official-account>

  <view class="home_band" wx:if="{{avatar}}">
    <view class="userinfo_card">
      <view class="home_band_top">
        <text class="home_brand">{{t.appName}}</text>
        <view class="userinfo_notice" bindtap="openInbox">
          <image class="userinfo_notice_icon" src="{{themeClass === 'theme-dark' ? '/image/linear/dark/bell.svg' : '/image/linear/light/bell.svg'}}" mode="aspectFit"></image>
          <text class="userinfo_notice_badge" wx:if="{{inboxBadgeText}}">{{inboxBadgeText}}</text>
        </view>
      </view>

      <view class="userinfo">
        <image class="userinfo-avatar" src="{{avatar}}" mode="aspectFill"></image>
        <view class="userinfo_meta">
          <text class="userinfo-nickname">{{nickname}}</text>
          <text class="userinfo-date">{{todayDate}}</text>
        </view>
      </view>

      <text class="userinfo-entry" bindtap="openProfile">{{t.viewProfile}}</text>
    </view>
  </view>

  <view class="page-body">
    <navigator wx:if="{{todayVisible}}" class="today-card" url="/pages/schedule/schedule" open-type="navigate">
      <view class="today-card__heading"><text>{{t.todayTitle}}</text><text class="today-card__source">{{todaySource}}</text></view>
      <text class="today-card__status" wx:if="{{today.status === 'loading'}}">{{t.todayLoading}}</text>
      <text class="today-card__status" wx:elif="{{today.status === 'empty'}}">{{t.todayEmpty}}</text>
      <text class="today-card__status" wx:elif="{{today.status === 'unavailable'}}">{{t.todayUnavailable}}</text>
      <view class="today-card__lesson" wx:for="{{today.lessons}}" wx:key="index">
        <text class="today-card__period">{{item.lesson}}</text>
        <view class="today-card__detail"><text class="today-card__name">{{item.name}}</text><text class="today-card__location" wx:if="{{item.location}}">{{item.location}}</text></view>
      </view>
      <view class="today-card__footer"><text>{{t.viewSchedule}} ›</text></view>
    </navigator>
    <view class="page__bd" wx:if="{{homeSections.length}}">
      <block wx:for="{{homeSections}}" wx:key="id" wx:for-item="section">
        <view class="section_title">{{section.title}}</view>
        <view class="weui-grids">
          <navigator wx:for="{{section.features}}" wx:key="id" wx:for-item="feature" open-type="navigate" url="{{feature.page}}" class="weui-grid" hover-class="weui-grid_active">
            <image class="weui-grid__icon" src="{{themeClass === 'theme-dark' ? feature.iconDark : feature.icon}}" />
            <view class="weui-grid__label">{{feature.title}}</view>
          </navigator>
        </view>
      </block>

      <view class="section_title">{{t.settingsSection}}</view>
      <view class="weui-grids">
        <block wx:for="{{systemActions}}" wx:key="id" wx:for-item="actionItem">
          <navigator wx:if="{{actionItem.page}}" open-type="navigate" url="{{actionItem.page}}" class="weui-grid" hover-class="weui-grid_active">
            <image class="weui-grid__icon" src="{{themeClass === 'theme-dark' ? actionItem.iconDark : actionItem.icon}}" />
            <view class="weui-grid__label">{{actionItem.title}}</view>
          </navigator>
          <view wx:else data-action="{{actionItem.action}}" bindtap="handleActionTap" class="weui-grid" hover-class="weui-grid_active">
            <image class="weui-grid__icon" src="{{themeClass === 'theme-dark' ? actionItem.iconDark : actionItem.icon}}" />
            <view class="weui-grid__label">{{actionItem.title}}</view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view class="copyright_info">
    <text>{{t.copyright}}</text>
    <text>{{t.rightsReserved}}</text>
  </view>

</view>
