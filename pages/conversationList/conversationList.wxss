@import "../../common/lib/weui.wxss";

.page {
  min-height: 100vh;
  background: var(--color-bg-primary);
}

.item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: var(--color-bg-secondary);
}

.body {
  flex: 1;
  min-width: 0;
}

.name_row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.name {
  color: var(--color-text-primary);
  font-size: 30rpx;
}

.time {
  color: var(--color-text-tertiary);
  font-size: 22rpx;
}

.preview {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  margin-left: 12rpx;
  min-width: 36rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full);
  background: var(--color-danger);
  color: #FFFFFF;
  font-size: 20rpx;
  text-align: center;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-tertiary);
}
