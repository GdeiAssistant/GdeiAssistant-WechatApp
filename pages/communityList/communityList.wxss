@import "../../common/lib/weui.wxss";

.community-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-primary);
}

/* Module header: icon tile then title and summary, flat on the canvas. */
.hero_card {
  display: flex;
  align-items: center;
  padding: 40rpx var(--gutter) 8rpx;
}

.hero_icon {
  order: -1;
  width: 96rpx;
  height: 96rpx;
  margin-right: 28rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: var(--color-primary-soft);
  flex-shrink: 0;
}

.hero_content {
  flex: 1;
  min-width: 0;
}

.hero_title {
  color: var(--color-text-primary);
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1.25;
}

.hero_summary {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.6;
}

/* Photo stats: one strip, figures divided by hairlines. */
.stats_panel {
  display: flex;
  margin: 32rpx var(--gutter) 0;
  padding: 24rpx 0;
  background: var(--color-surface);
  border-radius: var(--radius-card);
}

.stat_item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  border-left: 1rpx solid var(--color-divider);
}

.stat_item:first-child {
  border-left: 0;
}

.stat_value {
  color: var(--color-text-primary);
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.stat_label {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: 1.35;
  text-align: center;
  word-break: break-word;
}

/* Search: pill field with inline actions. */
.search_bar {
  display: flex;
  align-items: center;
  margin: 32rpx var(--gutter) 0;
}

.search_input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-full);
  font-size: var(--font-meta);
}

.search_button {
  margin: 0 0 0 16rpx;
  flex-shrink: 0;
}

.search_button_secondary {
  background: var(--color-surface);
  color: var(--color-text-secondary);
}

/* Filter chips */
.tab_scroll {
  margin-top: 28rpx;
  white-space: nowrap;
}

.tab_row {
  display: flex;
  padding: 0 var(--gutter);
}

.tab_item {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 0 28rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  font-weight: 600;
}

.tab_item_active {
  background: var(--color-fill-primary);
  color: var(--color-on-primary);
}

/* Feed */
.list_section {
  padding: 28rpx var(--gutter) 0;
}

.market_card,
.post_card,
.delivery_card,
.photo_card,
.lost_card,
.dating_card {
  margin-bottom: 20rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  overflow: hidden;
}

/* Second-hand: thumbnail row */
.market_card {
  display: flex;
}

.market_cover {
  width: 200rpx;
  height: 200rpx;
  margin: 24rpx 0 24rpx 24rpx;
  border-radius: var(--radius-control);
  background: var(--color-surface-sunken);
  flex-shrink: 0;
}

.market_content {
  flex: 1;
  min-width: 0;
  padding: 24rpx 28rpx;
}

/* Two-column grids: lost and found, dating */
.lost_grid,
.dating_grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.lost_card,
.dating_card {
  width: 48.5%;
}

.lost_cover,
.dating_cover {
  display: block;
  width: 100%;
  height: 240rpx;
  background: var(--color-surface-sunken);
}

.lost_badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 20rpx 20rpx 0;
}

.lost_badges .card_badge {
  margin-right: 8rpx;
}

.photo_cover,
.topic_cover {
  display: block;
  width: 100%;
  height: 360rpx;
  background: var(--color-surface-sunken);
}

.delivery_card,
.secret_card {
  padding: 28rpx;
}

.delivery_header,
.card_footer,
.card_meta_row,
.post_footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.card_meta_row {
  margin-top: 12rpx;
  justify-content: flex-start;
}

.card_footer {
  margin-top: 12rpx;
}

.delivery_header .card_title {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.post_footer .time_text {
  flex: 1;
}

.post_footer .metric_text {
  margin-left: 20rpx;
}

.card_title {
  color: var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: 600;
  line-height: 1.45;
  word-break: break-word;
}

.card_summary {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.6;
  word-break: break-word;
}

.card_badge,
.card_sub_badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
  font-size: var(--font-caption);
  font-weight: 600;
  line-height: 1.4;
  flex-shrink: 0;
}

.card_sub_badge {
  background: var(--color-surface-sunken);
  color: var(--color-text-secondary);
}

.delivery_badge {
  background: var(--color-warning-soft);
  color: var(--color-warning-ink);
}

.card_meta {
  flex: 1;
  min-width: 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
  line-height: 1.5;
  word-break: break-word;
}

.card_meta_row .card_meta {
  margin-left: 12rpx;
}

.price_text {
  color: var(--color-danger-ink);
  font-size: var(--font-title);
  font-weight: 700;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.time_text,
.metric_text {
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
  line-height: 1.4;
}

/* Anonymous posts: quiet accent rule on the leading edge. */
.secret_card {
  border-left: 8rpx solid var(--color-primary);
}

.delivery_card .card_summary {
  margin-top: 12rpx;
}

.delivery_card .time_text {
  display: block;
  margin-top: 12rpx;
}

.dating_card .card_title,
.dating_card .card_meta,
.dating_card .card_summary,
.dating_card .time_text,
.photo_card .card_title,
.photo_card .card_summary,
.photo_card .post_footer,
.post_card .card_title,
.post_card .card_summary,
.post_card .post_footer,
.lost_card .card_title,
.lost_card .card_summary,
.lost_card .card_meta,
.lost_card .time_text {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.secret_card .card_title,
.secret_card .card_summary,
.secret_card .post_footer {
  padding-left: 0;
  padding-right: 0;
}

.dating_card .card_title,
.photo_card .card_title,
.post_card .card_title,
.lost_card .card_title {
  margin-top: 20rpx;
}

.secret_card .card_title {
  margin-top: 0;
}

.dating_card .card_meta,
.lost_card .card_meta {
  display: block;
  margin-top: 6rpx;
}

.dating_card .card_summary {
  min-height: 84rpx;
}

.dating_card .time_text,
.lost_card .time_text {
  display: block;
  padding-top: 12rpx;
  padding-bottom: 24rpx;
}

.photo_card .post_footer,
.post_card .post_footer {
  padding-top: 16rpx;
  padding-bottom: 24rpx;
}

.secret_card .post_footer {
  padding-bottom: 0;
}

/* Empty state */
.empty_panel {
  margin: 32rpx var(--gutter) 0;
  padding: 40rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
}

.empty_title {
  color: var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: 600;
  line-height: 1.4;
}

.empty_summary {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.6;
}

/* Fixed actions above the home indicator */
.bottom_bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  padding: 16rpx var(--gutter) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-primary);
  border-top: 1rpx solid var(--color-divider);
}

.bottom_button {
  flex: 1;
  margin: 0;
  border-radius: var(--radius-full);
}

.bottom_button + .bottom_button {
  margin-left: 16rpx;
}

.bottom_button_secondary {
  background: var(--color-surface);
  color: var(--color-text-primary);
}
