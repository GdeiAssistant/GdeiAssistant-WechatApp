@import "../../common/lib/weui.wxss";

.inbox_page {
  min-height: 100vh;
  background: var(--color-bg-primary);
}

.inbox_tabs {
  position: sticky;
  top: 0;
  z-index: 20;
}

/* Each tab is one column: an optional meta row on the canvas, then one grouped surface. */
.section_card {
  margin: 24rpx var(--gutter) 0;
}

.section_card .weui-cells {
  margin: 0;
}

.item_title {
  padding-right: 16rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  line-height: 1.45;
  word-break: break-word;
}

.item_summary {
  margin-top: 8rpx;
  padding-right: 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.6;
}

.item_date {
  flex-shrink: 0;
  align-self: flex-start;
  font-size: var(--font-caption);
  font-variant-numeric: tabular-nums;
}

.interaction_meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.meta_badge {
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  font-weight: 600;
}

.meta_action {
  color: var(--color-primary-ink);
  font-size: var(--font-meta);
  font-weight: 600;
}

.interaction_list {
  border-radius: var(--radius-card);
  background: var(--color-surface);
  overflow: hidden;
}

.interaction_card {
  padding: 28rpx 32rpx;
  background: var(--color-surface);
}

.interaction_card + .interaction_card {
  border-top: 1rpx solid var(--color-divider);
}

.interaction_card_active {
  background: var(--color-bg-secondary);
}

.interaction_header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.interaction_title {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  color: var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: 600;
  line-height: 1.45;
  word-break: break-word;
}

.interaction_read {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-caption);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.interaction_read_done {
  background: var(--color-surface-sunken);
  color: var(--color-text-tertiary);
}

.interaction_read_pending {
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
}

.interaction_tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.interaction_tag {
  margin-right: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface-sunken);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.interaction_tag_secondary {
  background: transparent;
  box-shadow: inset 0 0 0 1rpx var(--color-border);
}

.interaction_content {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.65;
  word-break: break-word;
}

.interaction_time {
  margin-top: 12rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
  font-variant-numeric: tabular-nums;
}

.direct_all {
  padding: 24rpx 8rpx 0;
  text-align: left;
}

.section_card .weui-loadmore {
  margin-left: 0;
  margin-right: 0;
}
