@import "../../common/lib/weui.wxss";

.news_page {
  min-height: 100vh;
  background: var(--color-bg-primary);
}

/* Category filter: a sticky row of chips on the canvas. */
.news_type_scroll {
  position: sticky;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: 20rpx var(--gutter);
  background: var(--color-bg-primary);
}

.news_type_row {
  display: flex;
  flex-wrap: wrap;
}

.news_type_item {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.4;
}

.news_type_item_active {
  background: var(--color-fill-primary);
  color: var(--color-on-primary);
  font-weight: 600;
}

.section_card {
  margin: 0 var(--gutter);
}

.section_card .weui-cells {
  margin: 0;
}

.news_title {
  padding-right: 16rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  line-height: 1.5;
  word-break: break-word;
}

.news_date {
  flex-shrink: 0;
  font-size: var(--font-caption);
  font-variant-numeric: tabular-nums;
}

.section_card .weui-loadmore {
  margin-left: 0;
  margin-right: 0;
}
