@import "../../common/lib/weui.wxss";

.schedule-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: var(--color-bg-primary);
}

/* Seven weekdays share one segmented track; labels stay on one line at phone width. */
.schedule-navbar {
  position: relative;
}

.schedule-navbar .weui-navbar__item {
  padding-left: 0;
  padding-right: 0;
}

.schedule-navbar .weui-navbar__title {
  font-size: var(--font-caption);
  white-space: nowrap;
  line-height: 1.3;
}

.schedule-toolbar {
  padding: 24rpx var(--gutter) 0;
}

.schedule-week-button {
  width: 100%;
  min-height: 80rpx;
  margin: 0;
  border-radius: var(--radius-full);
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
  font-size: var(--font-meta);
  font-weight: 600;
  line-height: 80rpx;
}

.schedule-week-button::after {
  border-color: transparent;
}

.schedule-panel {
  padding: 8rpx var(--gutter) 24rpx;
}

/* Each lesson: period chip and week range on top, course name as the headline. */
.schedule-card {
  margin-top: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-card);
  background-color: var(--color-surface);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.schedule-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.schedule-card__lesson {
  min-width: 0;
  margin-right: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
  font-size: var(--font-caption);
  font-weight: 600;
  line-height: 1.5;
}

.schedule-card__week {
  flex-shrink: 0;
  max-width: 50%;
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
  line-height: 1.4;
  text-align: right;
  white-space: normal;
}

.schedule-card__name {
  color: var(--color-text-primary);
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.35;
}

.schedule-card__details {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.schedule-card__detail {
  max-width: 100%;
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.45;
  word-break: break-all;
}

.schedule-card__teacher {
  margin-right: 24rpx;
}
