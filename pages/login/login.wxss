@import "../../common/lib/weui.wxss";

.container {
  background: var(--color-bg-primary);
}

.page-section {
  margin-bottom: 20rpx;
}

.page-body {
  margin-top: 40rpx;
}

form {
  width: 100%;
}

.userinfo {
  margin-top: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.userinfo-avatar {
  width: 144rpx;
  height: 144rpx;
  margin: 12rpx 20rpx 24rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.userinfo-nickname {
  color: var(--color-text-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.userinfo-source {
  margin-top: 8rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.weui-cells {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.login_aux {
  margin: 40rpx 48rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-divider);
}

.mock_toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
}

.mock_label {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.mock_switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.mock_hint {
  display: block;
  margin: 12rpx 8rpx 0;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  line-height: 1.5;
}

.settings_link {
  display: block;
  margin-top: 14rpx;
  padding: 0 8rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.consent_section {
  margin: 32rpx 48rpx 8rpx;
}

.consent_label {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.consent_text {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  min-width: 0;
}

.consent_detail_link {
  margin-left: 12rpx;
  color: var(--color-link);
  font-weight: 600;
}

.version_info {
  margin: 48rpx 0 40rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}
