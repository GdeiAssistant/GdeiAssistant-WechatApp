@import "../../common/lib/weui.wxss";

.container {
  background: var(--color-bg-primary);
  justify-content: flex-start;
}

/* Brand band: logo, product name and data source, left aligned. */
.login_band {
  background: var(--color-band);
  padding: 72rpx var(--gutter) 64rpx;
  border-radius: 0 0 var(--radius-card) var(--radius-card);
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.userinfo-avatar {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.userinfo-nickname {
  color: var(--color-on-band);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-body {
  margin-top: 48rpx;
  flex-grow: 1;
}

form {
  width: 100%;
}

.page-section {
  margin-bottom: 0;
}

.login_fields .weui-cell {
  min-height: 112rpx;
}

.consent_section {
  margin: 32rpx var(--gutter) 0;
  padding: 0 8rpx;
}

.consent_label {
  display: flex;
  align-items: flex-start;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.6;
}

.consent_text {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  min-width: 0;
}

.consent_detail_link {
  margin-left: 12rpx;
  color: var(--color-link);
  font-weight: 600;
}

.btn-area {
  margin-top: 40rpx;
}

/* Secondary tools sit in one quiet group under the primary action. */
.login_aux {
  margin: 48rpx var(--gutter) 0;
  padding: 8rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--color-surface);
}

.mock_toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.mock_label {
  color: var(--color-text-primary);
  font-size: var(--font-body);
}

.mock_switch {
  transform: scale(0.86);
  transform-origin: right center;
}

.mock_hint {
  display: block;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.55;
}

.settings_link {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  color: var(--color-primary-ink);
  font-size: var(--font-body);
  font-weight: 600;
}

.version_info {
  margin: 48rpx 0 40rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
  font-variant-numeric: tabular-nums;
}
