.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
}

.section-title {
  margin: 48rpx 0 0;
  padding: 0 calc(var(--gutter) + 8rpx) 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  font-weight: 600;
  line-height: 1.4;
}

.option-list,
.font-card {
  margin: 0 var(--gutter);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.accent-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 0 var(--gutter);
}

.accent-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-card);
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  transition: border-color 0.15s ease;
}

.accent-item--active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.accent-swatch-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.accent-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.accent-name {
  flex: 1;
  min-width: 0;
  color: var(--color-text-primary);
  font-size: var(--font-meta);
  font-weight: 500;
}

.accent-check {
  width: 34rpx;
  height: 34rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.option-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  box-sizing: border-box;
  padding: 26rpx 32rpx;
  color: var(--color-text-primary);
  font-size: var(--font-body);
}

.option-item + .option-item {
  border-top: 1rpx solid var(--color-divider);
}

/* Selected state: a filled emerald disc behind the check glyph. */
.check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-fill-primary);
  color: var(--color-on-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.font-card {
  padding: 24rpx 32rpx 32rpx;
}

.font-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
}

.font-preview {
  display: block;
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: var(--radius-control);
  background: var(--color-surface-sunken);
  color: var(--color-text-primary);
  line-height: 1.5;
}
