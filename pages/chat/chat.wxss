@import "../../common/lib/weui.wxss";

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7f5;
}

.chat_header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e4ebe4;
}

.chat_header_avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f5e9;
}

.chat_header_meta {
  flex: 1;
  min-width: 0;
}

.chat_header_name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2a1f;
}

.chat_header_sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7b6b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
  box-sizing: border-box;
}

.bubble_row {
  display: flex;
  margin-bottom: 24rpx;
}

.bubble_row.mine {
  justify-content: flex-end;
}

.bubble_wrap {
  max-width: 74%;
}

.time {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  color: #8a968a;
  text-align: center;
}

.bubble {
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #1f2a1f;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
  border: 1rpx solid #dce6dc;
}

.bubble_row.mine .bubble {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
}

.bubble_image {
  padding: 8rpx;
  overflow: hidden;
}

.bubble_failed {
  opacity: 0.85;
}

.chat_image {
  width: 320rpx;
  height: 320rpx;
  border-radius: 12rpx;
  background: #eef5ee;
  display: block;
}

.chat_image_placeholder {
  width: 320rpx;
  height: 320rpx;
  border-radius: 12rpx;
  background: #eef5ee;
  color: #6b7b6b;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8a968a;
  text-align: right;
}

.hint {
  padding: 12rpx 24rpx;
  color: #6b7b6b;
  font-size: 22rpx;
  background: #ffffff;
  border-top: 1rpx solid #e4ebe4;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-top: 1rpx solid #e4ebe4;
}

.safe_composer {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.composer_input {
  flex: 1;
  min-height: 72rpx;
  max-height: 180rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f5f7f5;
  color: #1f2a1f;
  font-size: 28rpx;
}

.composer_icon_btn,
.composer_send_btn {
  height: 44px;
  min-width: 44px;
  line-height: 44px;
  padding: 0 20rpx;
  margin: 0;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.composer_icon_btn {
  background: #e8f5e9;
  color: #07c160;
}

.load_earlier {
  text-align: center;
  padding: 12rpx;
  color: #6b7b6b;
  font-size: 24rpx;
}

.image_draft_mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 28, 20, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  padding: 40rpx;
  box-sizing: border-box;
}

.image_draft_card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.image_draft_preview {
  width: 100%;
  height: 480rpx;
  background: #f5f7f5;
  border-radius: 12rpx;
}

.image_draft_actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
