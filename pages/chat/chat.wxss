@import "../../common/lib/weui.wxss";

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-primary);
}

.chat_header {
  display: flex;
  align-items: center;
  padding: 20rpx var(--gutter);
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-divider);
}

.chat_header_avatar {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  flex-shrink: 0;
}

.chat_header_meta {
  flex: 1;
  min-width: 0;
}

.chat_header_name {
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--color-text-primary);
}

.chat_header_sub {
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx var(--gutter);
  box-sizing: border-box;
}

.bubble_row {
  display: flex;
  margin-bottom: 24rpx;
}

.bubble_row.mine {
  justify-content: flex-end;
}

.bubble_wrap {
  max-width: 74%;
}

.time {
  margin-bottom: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

.bubble {
  padding: 20rpx 26rpx;
  border-radius: var(--radius-card);
  border-bottom-left-radius: 8rpx;
  background: var(--color-surface);
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: 1.5;
  word-break: break-word;
}

.bubble_row.mine .bubble {
  background: var(--color-fill-primary);
  color: var(--color-on-primary);
  border-bottom-left-radius: var(--radius-card);
  border-bottom-right-radius: 8rpx;
}

.bubble_image {
  padding: 8rpx;
  overflow: hidden;
}

.bubble_failed {
  box-shadow: inset 0 0 0 2rpx var(--color-danger);
}

.chat_image {
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--radius-control);
  background: var(--color-bg-secondary);
  display: block;
}

.chat_image_placeholder {
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--radius-control);
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  text-align: right;
}

.hint {
  padding: 16rpx var(--gutter);
  color: var(--color-warning-ink);
  font-size: var(--font-meta);
  line-height: 1.5;
  background: var(--color-warning-soft);
}

.composer {
  display: flex;
  align-items: flex-end;
  padding: 16rpx var(--gutter);
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-divider);
}

.safe_composer {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.composer_input {
  flex: 1;
  min-height: 56rpx;
  max-height: 180rpx;
  margin: 0 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 44rpx;
  background: var(--color-surface-sunken);
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: 1.4;
}

.composer_icon_btn,
.composer_send_btn {
  height: 44px;
  width: auto;
  min-width: 44px;
  line-height: 44px;
  padding: 0 24rpx;
  margin: 0;
  font-size: var(--font-meta);
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.composer_icon_btn {
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
}

.composer_icon_btn::after {
  border-color: transparent;
}

.load_earlier {
  display: table;
  margin: 0 auto 24rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  color: var(--color-primary-ink);
  font-size: var(--font-meta);
  text-align: center;
}

.image_draft_mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--color-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  padding: var(--gutter);
  box-sizing: border-box;
}

.image_draft_card {
  width: 100%;
  max-width: 640rpx;
  background: var(--color-surface-raised);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-raised);
  padding: 24rpx;
}

.image_draft_preview {
  width: 100%;
  height: 480rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-control);
}

.image_draft_actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.image_draft_actions .composer_send_btn + .composer_send_btn {
  margin-left: 16rpx;
}
