@import "../../common/lib/weui.wxss";

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg-primary);
}

.chat_header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-divider);
}

.chat_header_avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
}

.chat_header_meta {
  flex: 1;
  min-width: 0;
}

.chat_header_name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.chat_header_sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
  box-sizing: border-box;
}

.bubble_row {
  display: flex;
  margin-bottom: 24rpx;
}

.bubble_row.mine {
  justify-content: flex-end;
}

.bubble_wrap {
  max-width: 74%;
}

.time {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}

.bubble {
  padding: 18rpx 22rpx;
  border-radius: var(--radius-card);
  border-bottom-left-radius: 8rpx;
  background: var(--color-surface);
  color: var(--color-text-primary);
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.bubble_row.mine .bubble {
  background: var(--color-primary);
  color: var(--color-on-primary);
  border-color: var(--color-primary);
  border-bottom-left-radius: var(--radius-card);
  border-bottom-right-radius: 8rpx;
}

.bubble_image {
  padding: 8rpx;
  overflow: hidden;
}

.bubble_failed {
  opacity: 0.85;
}

.chat_image {
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--radius-control);
  background: var(--color-bg-secondary);
  display: block;
}

.chat_image_placeholder {
  width: 320rpx;
  height: 320rpx;
  border-radius: var(--radius-control);
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  text-align: right;
}

.hint {
  padding: 12rpx 24rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-divider);
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-divider);
}

.safe_composer {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.composer_input {
  flex: 1;
  min-height: 72rpx;
  max-height: 180rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-control);
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.composer_icon_btn,
.composer_send_btn {
  height: 44px;
  min-width: 44px;
  line-height: 44px;
  padding: 0 20rpx;
  margin: 0;
  font-size: 26rpx;
  border-radius: var(--radius-control);
}

.composer_icon_btn {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.load_earlier {
  text-align: center;
  padding: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.image_draft_mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--color-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  padding: 40rpx;
  box-sizing: border-box;
}

.image_draft_card {
  width: 100%;
  max-width: 640rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 24rpx;
}

.image_draft_preview {
  width: 100%;
  height: 480rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-control);
}

.image_draft_actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
