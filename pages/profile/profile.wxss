@import "../../common/lib/weui.wxss";

.profile_page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: var(--color-bg-primary);
}

.loading_box {
  padding: 80rpx 0;
  text-align: center;
  color: var(--color-text-tertiary);
}

.loading_box text {
  display: block;
  margin-top: 16rpx;
}

.profile_card {
  display: flex;
  flex-direction: column;
  margin: 24rpx 24rpx 0;
  padding: 30rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.profile_card_main {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.profile_avatar_wrap {
  position: relative;
  flex-shrink: 0;
}

.profile_avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--color-bg-secondary);
  border: 6rpx solid var(--color-surface);
}

.avatar_badge {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  transform: translateX(-50%);
  min-width: 92rpx;
  max-width: 168rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
  white-space: normal;
  word-break: break-word;
}

.profile_meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding-top: 8rpx;
}

.profile_name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  word-break: break-word;
}

.profile_subtitle {
  margin-top: 10rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.profile_status {
  margin-top: 12rpx;
  color: var(--color-primary);
  font-size: 24rpx;
}

.profile_intro {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.profile_cells {
  margin: 0 24rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.textarea_wrap {
  width: 100%;
  max-width: 100%;
}

.profile_textarea {
  width: 100%;
  box-sizing: border-box;
  color: var(--color-text-primary);
}

.profile_textarea {
  min-height: 140rpx;
  text-align: left;
  line-height: 1.7;
}

.multi_line_value {
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
}

.introduction_cell {
  align-items: flex-start;
}

.profile_stats {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  margin-top: 24rpx;
  gap: 16rpx;
}

.social_stat {
  flex: 1 1 0;
  min-width: 0;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx 8rpx;
}

.social_stat_value {
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.social_stat_label {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--color-text-tertiary);
  white-space: normal;
  word-break: break-word;
}
