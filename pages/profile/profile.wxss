@import "../../common/lib/weui.wxss";

.profile_page {
  min-height: 100vh;
  background: var(--color-bg-primary);
}

.loading_box {
  margin: 48rpx var(--gutter) 0;
  padding: 64rpx 32rpx;
  border-radius: var(--radius-card);
  background: var(--color-surface);
  color: var(--color-text-tertiary);
  font-size: var(--font-meta);
  text-align: center;
}

.loading_box text {
  display: block;
  margin-top: 16rpx;
}

/* Identity sits in the brand band, the same signature as the home screen. */
.profile_card {
  display: flex;
  flex-direction: column;
  padding: 40rpx var(--gutter) 32rpx;
  background: var(--color-band);
  border-radius: 0 0 var(--radius-card) var(--radius-card);
}

.profile_card_main {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.profile_avatar_wrap {
  position: relative;
  flex-shrink: 0;
  padding-bottom: 20rpx;
}

.profile_avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: var(--color-band-chip);
  border: 4rpx solid var(--color-band-chip);
}

.avatar_badge {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  min-width: 96rpx;
  max-width: 168rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  color: var(--color-primary-ink);
  font-size: var(--font-caption);
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  white-space: normal;
  word-break: break-word;
}

.profile_meta {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
  padding-top: 4rpx;
}

.profile_name {
  color: var(--color-on-band);
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1.2;
  word-break: break-word;
}

.profile_subtitle {
  margin-top: 8rpx;
  color: var(--color-on-band-muted);
  font-size: var(--font-meta);
  line-height: 1.4;
  word-break: break-word;
}

.profile_status {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  background: var(--color-band-chip);
  color: var(--color-on-band);
  font-size: var(--font-caption);
}

.profile_intro {
  margin-top: 16rpx;
  color: var(--color-on-band);
  font-size: var(--font-meta);
  line-height: 1.65;
  word-break: break-word;
}

/* Follow counts: one tinted strip split by hairlines, each segment tappable. */
.profile_stats {
  display: flex;
  width: 100%;
  margin-top: 32rpx;
  border-radius: var(--radius-control);
  background: var(--color-band-chip);
}

.social_stat {
  flex: 1 1 0;
  min-width: 0;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  text-align: center;
}

.social_stat + .social_stat {
  border-left: 1rpx solid var(--color-band-chip);
}

.social_stat_value {
  color: var(--color-on-band);
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.social_stat_label {
  margin-top: 4rpx;
  color: var(--color-on-band-muted);
  font-size: var(--font-caption);
  line-height: 1.35;
  white-space: normal;
  word-break: break-word;
}

.profile_cells {
  overflow: hidden;
}

.multi_line_value {
  white-space: normal;
  word-break: break-word;
}

/* Introduction: label above a full-width field instead of a squeezed right column. */
.introduction_cell {
  flex-direction: column;
  align-items: stretch;
}

.introduction_cell .weui-cell__bd {
  color: var(--color-text-primary);
}

.textarea_wrap {
  width: 100%;
  max-width: 100%;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-control);
  background: var(--color-surface-sunken);
  text-align: left;
}

.profile_textarea {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: 1.6;
  text-align: left;
}
