@import "../../common/lib/weui.wxss";

.page {
  min-height: 100vh;
  background: var(--color-bg-primary);
  padding-bottom: 40rpx;
}

.search_box {
  margin: 24rpx;
  padding: 16rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.search_input {
  width: 100%;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.user_row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: var(--color-bg-secondary);
}

.user_meta {
  flex: 1;
  min-width: 0;
}

.nickname {
  color: var(--color-text-primary);
  font-size: 30rpx;
}

.intro {
  margin-top: 6rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}
