@import "../../common/lib/weui.wxss";

.publish_page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-bg-primary);
}

/* Module header: icon tile then title and summary, flat on the canvas. */
.hero_card {
  display: flex;
  align-items: center;
  padding: 40rpx var(--gutter) 8rpx;
}

.hero_icon {
  order: -1;
  width: 96rpx;
  height: 96rpx;
  margin-right: 28rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: var(--color-primary-soft);
  flex-shrink: 0;
}

.hero_content {
  flex: 1;
  min-width: 0;
}

.hero_title {
  color: var(--color-text-primary);
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1.25;
}

.hero_summary {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  line-height: 1.6;
}

/* Form sections: label on the canvas, fields in one grouped surface. */
.publish_card {
  margin-top: 8rpx;
}

.section_title {
  margin: 40rpx 0 0;
  padding: 0 calc(var(--gutter) + 8rpx) 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-meta);
  font-weight: 600;
  line-height: 1.4;
}

.page_hint {
  margin: 0 calc(var(--gutter) + 8rpx) 16rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-meta);
}

.publish_card .weui-cells {
  margin-top: 0;
}

.picker_value {
  color: var(--color-text-primary);
  font-size: var(--font-body);
}

.voice_panel {
  display: flex;
  flex-direction: column;
  margin: 24rpx var(--gutter) 0;
}

.voice_panel button {
  width: 100%;
  margin: 0 0 16rpx;
}

.voice_hint,
.upload_hint {
  margin: 16rpx calc(var(--gutter) + 8rpx) 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-meta);
  line-height: 1.5;
}

.voice_panel .voice_hint {
  margin: 0 8rpx 16rpx;
}

/* Image picker: square thumbnails inside one surface, add tile drawn with a dashed outline. */
.image_list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 var(--gutter);
  padding: 24rpx 8rpx 8rpx 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-surface);
}

.image_item,
.image_add {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: var(--radius-control);
  overflow: hidden;
  background: var(--color-surface-sunken);
}

.image_preview {
  width: 100%;
  height: 100%;
}

.image_remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-overlay);
  color: #ffffff;
  text-align: center;
  line-height: 44rpx;
  font-size: var(--font-meta);
}

.image_add {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx dashed var(--color-border);
  background: transparent;
  color: var(--color-primary-ink);
  font-size: 64rpx;
  font-weight: 300;
}

.submit_area {
  margin: 48rpx var(--gutter) 0;
}
