{
  "name": "gdeiassistant-wechatapp",
  "version": "1.0.0",
  "private": true,
  "description": "广东二师助手微信小程序",
  "scripts": {
    "lint": "eslint app.js config constants custom-tab-bar mock pages services utils tests scripts",
    "format": "prettier --write \"services/**/*.js\" \"utils/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"services/**/*.js\" \"utils/**/*.js\" \"tests/**/*.js\"",
    "smoke": "node scripts/ci-smoke.js",
    "test": "npm run locales:check && node --test tests/*.test.js",
    "locales:generate": "node scripts/generate-locales.js",
    "locales:check": "node scripts/generate-locales.js --check"
  },
  "engines": {
    "node": "24.14.1"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "prettier": "^3.8.4"
  }
}
